# Copy to .env and fill in from Supabase → Project Settings → API.
# The publishable key is safe in the browser: Row Level Security requires sign-in.
# NEVER put the sb_secret_... key in here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_FULL_KEY
